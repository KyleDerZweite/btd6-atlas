{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raw purchase model",
  "type": "object",
  "required": [
    "$type",
    "tower",
    "upgrade"
  ],
  "properties": {
    "$type": {
      "type": "string",
      "minLength": 1,
      "pattern": "(^|\\.)(UpgradePathModel|PowerProUpgradePathModel)(,|$)"
    },
    "name": {
      "type": "string"
    },
    "tower": {
      "type": "string",
      "minLength": 1
    },
    "upgrade": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
