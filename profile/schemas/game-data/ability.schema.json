{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raw ability model",
  "type": "object",
  "required": [
    "$type",
    "cooldown",
    "behaviors"
  ],
  "properties": {
    "$type": {
      "type": "string",
      "minLength": 1,
      "pattern": "(^|\\.)(AbilityModel)(,|$)"
    },
    "name": {
      "type": "string"
    },
    "cooldown": {
      "type": "number"
    },
    "behaviors": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "model.schema.json#/$defs/model"
      }
    },
    "addedViaUpgrade": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
