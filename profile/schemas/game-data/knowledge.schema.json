{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raw knowledge model",
  "type": "object",
  "required": [
    "$type",
    "name",
    "prerequisiteIds",
    "mod"
  ],
  "properties": {
    "$type": {
      "type": "string",
      "minLength": 1,
      "pattern": "(^|\\.)(KnowledgeModel)(,|$)"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "prerequisiteIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "mod": {
      "$ref": "mod.schema.json"
    },
    "category": {
      "type": "integer"
    },
    "investmentRequired": {
      "type": "integer"
    },
    "monkeyMoneyCost": {
      "type": "number"
    }
  },
  "additionalProperties": true
}
