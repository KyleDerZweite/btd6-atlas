{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BTD6 raw capture contract",
  "description": "Validate exported models without rewriting their fields. Additional game fields remain valid. Typed model coverage is declared by the game profile.",
  "$defs": {
    "model": {
      "type": "object",
      "required": [
        "$type"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "namedModel": {
      "type": "object",
      "required": [
        "$type",
        "name"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "stringTable": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tower": {
      "type": "object",
      "required": [
        "$type",
        "name",
        "baseId",
        "cost",
        "range",
        "tiers",
        "towerSet",
        "upgrades",
        "appliedUpgrades",
        "behaviors"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "minLength": 1,
          "pattern": "(^|\\.)(TowerModel)(,|$)"
        },
        "name": {
          "type": "string"
        },
        "baseId": {
          "type": "string"
        },
        "cost": {
          "type": "number",
          "minimum": 0
        },
        "range": {
          "type": "number"
        },
        "tiers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "towerSet": {
          "type": "integer"
        },
        "upgrades": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/purchase"
          }
        },
        "appliedUpgrades": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "behaviors": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/model"
          }
        },
        "isParagon": {
          "type": "boolean"
        },
        "paragonUpgrade": {
          "anyOf": [
            {
              "$ref": "#/$defs/purchase"
            },
            {
              "type": "null"
            }
          ]
        },
        "areaTypes": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": true
    },
    "upgrade": {
      "type": "object",
      "required": [
        "$type",
        "name",
        "cost",
        "xpCost",
        "path",
        "tier",
        "LocsKey"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "minLength": 1,
          "pattern": "(^|\\.)(UpgradeModel|PowerProUpgradeModel)(,|$)"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "cost": {
          "type": "number",
          "minimum": 0
        },
        "xpCost": {
          "type": "number",
          "minimum": -1,
          "description": "The accepted capture uses -1 for some upgrade XP values."
        },
        "path": {
          "type": "integer"
        },
        "tier": {
          "type": "integer"
        },
        "LocsKey": {
          "type": "string",
          "minLength": 1
        },
        "IsParagon": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "purchase": {
      "type": "object",
      "required": [
        "$type",
        "tower",
        "upgrade"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "minLength": 1,
          "pattern": "(^|\\.)(UpgradePathModel|PowerProUpgradePathModel)(,|$)"
        },
        "name": {
          "type": "string"
        },
        "tower": {
          "type": "string",
          "minLength": 1
        },
        "upgrade": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "attack": {
      "type": "object",
      "required": [
        "$type",
        "weapons",
        "range"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "minLength": 1,
          "pattern": "(^|\\.)(AttackModel)(,|$)"
        },
        "name": {
          "type": "string"
        },
        "weapons": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/weapon"
          }
        },
        "range": {
          "type": "number"
        },
        "behaviors": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/model"
          }
        }
      },
      "additionalProperties": true
    },
    "weapon": {
      "type": "object",
      "required": [
        "$type",
        "rate",
        "projectile",
        "emission"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "minLength": 1,
          "pattern": "(^|\\.)(WeaponModel)(,|$)"
        },
        "name": {
          "type": "string"
        },
        "rate": {
          "type": "number"
        },
        "projectile": {
          "anyOf": [
            {
              "$ref": "#/$defs/projectile"
            },
            {
              "type": "null"
            }
          ]
        },
        "emission": {
          "anyOf": [
            {
              "$ref": "#/$defs/model"
            },
            {
              "type": "null"
            }
          ]
        },
        "behaviors": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/model"
          }
        }
      },
      "additionalProperties": true
    },
    "projectile": {
      "type": "object",
      "required": [
        "$type",
        "pierce",
        "behaviors"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "minLength": 1,
          "pattern": "(^|\\.)(ProjectileModel)(,|$)"
        },
        "name": {
          "type": "string"
        },
        "pierce": {
          "type": "number"
        },
        "maxPierce": {
          "type": "number"
        },
        "behaviors": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/model"
          }
        }
      },
      "additionalProperties": true
    },
    "damage": {
      "type": "object",
      "required": [
        "$type",
        "damage"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "minLength": 1,
          "pattern": "(^|\\.)(DamageModel)(,|$)"
        },
        "name": {
          "type": "string"
        },
        "damage": {
          "type": "number"
        },
        "maxDamage": {
          "type": "number"
        },
        "immuneBloonProperties": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "ability": {
      "type": "object",
      "required": [
        "$type",
        "cooldown",
        "behaviors"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "minLength": 1,
          "pattern": "(^|\\.)(AbilityModel)(,|$)"
        },
        "name": {
          "type": "string"
        },
        "cooldown": {
          "type": "number"
        },
        "behaviors": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/model"
          }
        },
        "addedViaUpgrade": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "knowledge": {
      "type": "object",
      "required": [
        "$type",
        "name",
        "prerequisiteIds",
        "mod"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "minLength": 1,
          "pattern": "(^|\\.)(KnowledgeModel)(,|$)"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "prerequisiteIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "mod": {
          "$ref": "#/$defs/mod"
        },
        "category": {
          "type": "integer"
        },
        "investmentRequired": {
          "type": "integer"
        },
        "monkeyMoneyCost": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "mod": {
      "type": "object",
      "required": [
        "$type",
        "name",
        "mutatorMods"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "minLength": 1,
          "pattern": "(^|\\.)(ModModel)(,|$)"
        },
        "name": {
          "type": "string"
        },
        "mutatorMods": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/model"
          }
        }
      },
      "additionalProperties": true
    },
    "bloon": {
      "type": "object",
      "required": [
        "$type",
        "name",
        "id",
        "baseId",
        "behaviors"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "minLength": 1,
          "pattern": "(^|\\.)(BloonModel)(,|$)"
        },
        "name": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "baseId": {
          "type": "string",
          "minLength": 1
        },
        "behaviors": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/model"
          }
        },
        "maxHealth": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "bloonGroup": {
      "type": "object",
      "required": [
        "$type",
        "bloon",
        "count",
        "start",
        "end"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "minLength": 1,
          "pattern": "(^|\\.)(BloonGroupModel)(,|$)"
        },
        "name": {
          "type": "string"
        },
        "bloon": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "round": {
      "type": "object",
      "required": [
        "$type",
        "groups"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "minLength": 1,
          "pattern": "(^|\\.)(RoundModel)(,|$)"
        },
        "name": {
          "type": "string"
        },
        "groups": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/bloonGroup"
          }
        },
        "emissions_": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/model"
          }
        }
      },
      "additionalProperties": true
    },
    "map": {
      "type": "object",
      "required": [
        "$type",
        "id",
        "difficulty"
      ],
      "properties": {
        "$type": {
          "type": "string",
          "minLength": 1,
          "pattern": "(^|\\.)(MapDetails)(,|$)"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "profile": {
      "type": "object",
      "required": [
        "formatVersion",
        "game",
        "schemaFile",
        "collections",
        "modelSchemas",
        "references",
        "reading"
      ],
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "game": {
          "type": "string",
          "minLength": 1
        },
        "schemaFile": {
          "type": "string",
          "minLength": 1
        },
        "collections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "path",
              "idField",
              "schema"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "idField": {
                "type": "string",
                "minLength": 1
              },
              "schema": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "modelSchemas": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "models",
              "field",
              "target"
            ],
            "properties": {
              "models": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "field": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "externalSymbols": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "aliases": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "reading": {
          "type": "object"
        },
        "requiredFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Optional fixed files required by the format, independent of capture inventories."
        }
      },
      "additionalProperties": false
    }
  }
}
