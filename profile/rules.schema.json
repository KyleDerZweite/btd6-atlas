{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic validation rules",
  "description": "Rule operations must be implemented by the checker. Unknown operations are errors.",
  "type": "object",
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "tiersField": {
            "type": "string",
            "minLength": 1
          },
          "familyField": {
            "type": "string",
            "minLength": 1
          },
          "limits": {
            "type": "object",
            "properties": {
              "pathCount": {
                "type": "integer",
                "minimum": 1
              },
              "maxTier": {
                "type": "integer",
                "minimum": 1
              },
              "maxPurchasedPaths": {
                "type": "integer",
                "minimum": 0
              },
              "secondaryTierLimit": {
                "type": "integer",
                "minimum": 0
              },
              "maxPathsAboveSecondaryTier": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "pathCount",
              "maxTier",
              "maxPurchasedPaths",
              "secondaryTierLimit",
              "maxPathsAboveSecondaryTier"
            ],
            "additionalProperties": false
          },
          "requireCompleteStates": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "operation",
          "scope",
          "tiersField",
          "familyField",
          "limits",
          "requireCompleteStates"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "rules"
  ],
  "additionalProperties": false
}
