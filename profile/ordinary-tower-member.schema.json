{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ordinary purchase family members",
  "description": "Select candidates whose families must have a progression root. Temporary forms can remain outside the purchase graph.",
  "type": "object",
  "required": [
    "towerSet",
    "isSubTower",
    "isParagon"
  ],
  "properties": {
    "towerSet": {
      "enum": [
        1,
        2,
        4,
        8
      ]
    },
    "isSubTower": {
      "const": false
    },
    "isParagon": {
      "const": false
    }
  },
  "additionalProperties": true
}
