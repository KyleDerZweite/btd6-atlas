{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raw tower model",
  "type": "object",
  "required": [
    "$type",
    "name",
    "baseId",
    "cost",
    "range",
    "tiers",
    "towerSet",
    "upgrades",
    "appliedUpgrades",
    "behaviors",
    "IsBaseTower",
    "isSubTower",
    "isParagon"
  ],
  "properties": {
    "$type": {
      "type": "string",
      "minLength": 1,
      "pattern": "(^|\\.)(TowerModel)(,|$)"
    },
    "name": {
      "type": "string"
    },
    "baseId": {
      "type": "string"
    },
    "cost": {
      "type": "number",
      "minimum": 0
    },
    "range": {
      "type": "number"
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "towerSet": {
      "type": "integer"
    },
    "upgrades": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "purchase.schema.json"
      }
    },
    "appliedUpgrades": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "behaviors": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "model.schema.json#/$defs/model"
      }
    },
    "isParagon": {
      "type": "boolean"
    },
    "paragonUpgrade": {
      "anyOf": [
        {
          "$ref": "purchase.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "areaTypes": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "IsBaseTower": {
      "type": "boolean"
    },
    "isSubTower": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
